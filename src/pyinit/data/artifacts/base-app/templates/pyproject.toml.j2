[project]
name = "{{ project_name }}"
version = "0.1.0"  # project-version
description = "{{ project_name }} project generated by pyinit."
readme = "README.md"
authors = [
    { name = {{ author_name | tojson }} }
]
requires-python = ">={{ python_version }}"
{% if runtime_dependencies %}dependencies = [
{% for dependency in runtime_dependencies %}    "{{ dependency }}",
{% endfor %}]{% else %}dependencies = []{% endif %}

{% if has_entrypoint %}[project.scripts]
"{{ project_name }}" = "{{ package_name }}.main:main"

{% endif %}[build-system]
requires = ["uv_build>=0.10.9,<0.11.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
{% for dependency in dev_dependencies %}    "{{ dependency }}",
{% endfor %}]
{% if e2e_dependencies %}
e2e = [
{% for dependency in e2e_dependencies %}    "{{ dependency }}",
{% endfor %}]
{% endif %}

[tool.ruff]
target-version = "py{{ python_version | replace(".", "") }}"
line-length = 120
extend-exclude = [".kilo"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "N", "D", "UP", "B", "SIM", "RUF"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.basedpyright]
pythonVersion = "{{ python_version }}"
typeCheckingMode = "strict"
venvPath = "."
venv = ".venv"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = ["-ra", "-q", "--strict-markers"]
markers = [
    "e2e: opt-in Docker suite; run only via `just test-e2e`",
    "agent: opt-in provider suite; run only via `just test-agent`",
]

[tool.coverage.report]
fail_under = 90
exclude_also = [
    "if __name__ == .__main__.:",
]

[tool.bumpversion]
current_version = "0.1.0"
commit = true
tag = true
tag_name = "v{new_version}"
message = "chore: bump version from {current_version} to {new_version}"
pre_commit_hooks = ["uv lock", "git add uv.lock"]

[[tool.bumpversion.files]]
filename = "pyproject.toml"
search = 'version = "{current_version}"  # project-version'
replace = 'version = "{new_version}"  # project-version'

[[tool.bumpversion.files]]
filename = "src/{{ package_name }}/__init__.py"
search = '__version__ = "{current_version}"'
replace = '__version__ = "{new_version}"'
