"""State-changing form actions."""

from __future__ import annotations

from typing import Annotated

from fastapi import APIRouter, Depends, HTTPException
from fastapi.responses import RedirectResponse

from {{ package_name }}.domain.ports import RecordRepository
from {{ package_name }}.web.dependencies import get_repository

router = APIRouter()


@router.post("/records/{record_id}/touch")
def touch_record(
    record_id: str,
    repository: Annotated[RecordRepository, Depends(get_repository)],
) -> RedirectResponse:
    """Mark a record as touched and redirect back to its detail page."""
    if repository.touch(record_id) is None:
        raise HTTPException(status_code=404, detail="record not found")
    return RedirectResponse(url=f"/records/{record_id}", status_code=303)
