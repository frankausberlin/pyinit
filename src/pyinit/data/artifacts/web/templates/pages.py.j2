"""Server-rendered pages."""

from __future__ import annotations

from typing import Annotated

from fastapi import APIRouter, Depends, HTTPException, Request
from fastapi.responses import HTMLResponse

from {{ package_name }}.domain.ports import RecordRepository
from {{ package_name }}.web.dependencies import get_repository, get_settings, get_templates

router = APIRouter()


@router.get("/", response_class=HTMLResponse)
def index(
    request: Request,
    repository: Annotated[RecordRepository, Depends(get_repository)],
) -> HTMLResponse:
    """Render the landing page with an overview."""
    templates = get_templates(request)
    return templates.TemplateResponse(
        request=request,
        name="index.html",
        context={"settings": get_settings(request), "records": repository.list()},
    )


@router.get("/records", response_class=HTMLResponse)
def list_records(
    request: Request,
    repository: Annotated[RecordRepository, Depends(get_repository)],
) -> HTMLResponse:
    """Render every record as a table."""
    templates = get_templates(request)
    return templates.TemplateResponse(
        request=request,
        name="records/list.html",
        context={"settings": get_settings(request), "records": repository.list()},
    )


@router.get("/records/{record_id}", response_class=HTMLResponse)
def record_detail(
    request: Request,
    record_id: str,
    repository: Annotated[RecordRepository, Depends(get_repository)],
) -> HTMLResponse:
    """Render one record or return 404."""
    record = repository.get(record_id)
    if record is None:
        raise HTTPException(status_code=404, detail="record not found")
    templates = get_templates(request)
    return templates.TemplateResponse(
        request=request,
        name="records/detail.html",
        context={"settings": get_settings(request), "record": record},
    )
