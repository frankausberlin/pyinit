"""Runtime settings for {{ project_name }}."""

from __future__ import annotations

import os
from dataclasses import dataclass

_DEFAULT_APP_NAME = {{ project_name | tojson }}
_DEFAULT_HOST = "127.0.0.1"
_DEFAULT_PORT = 8000


@dataclass(frozen=True, slots=True)
class Settings:
    """Application settings read from ``WEB_*`` environment variables."""

    app_name: str = _DEFAULT_APP_NAME
    host: str = _DEFAULT_HOST
    port: int = _DEFAULT_PORT

    @classmethod
    def from_env(cls) -> Settings:
        """Build settings from ``WEB_APP_NAME``, ``WEB_HOST`` and ``WEB_PORT``."""
        return cls(
            app_name=os.environ.get("WEB_APP_NAME", _DEFAULT_APP_NAME),
            host=os.environ.get("WEB_HOST", _DEFAULT_HOST),
            port=int(os.environ.get("WEB_PORT", str(_DEFAULT_PORT))),
        )
