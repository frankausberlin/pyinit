"""Tests for state-changing form actions."""

from __future__ import annotations

from fastapi.testclient import TestClient

from {{ package_name }}.app import app


def test_touch_redirects_to_the_detail_page() -> None:
    """Touching a record redirects and shows the new status."""
    response = TestClient(app).post("/records/beta/touch", follow_redirects=True)
    assert response.status_code == 200
    assert "touched" in response.text


def test_touch_unknown_record_returns_404() -> None:
    """Touching an unknown record returns 404."""
    response = TestClient(app).post("/records/unknown/touch")
    assert response.status_code == 404
