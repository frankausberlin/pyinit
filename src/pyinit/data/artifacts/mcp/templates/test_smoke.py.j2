"""Smoke test for the {{ project_name }} MCP entry point."""

from __future__ import annotations

import pytest

from {{ package_name }} import main as main_module
from {{ package_name }}.server import mcp


def test_entry_point_starts_server(monkeypatch: pytest.MonkeyPatch) -> None:
    """The console entry point starts the stdio server."""
    calls: list[bool] = []
    monkeypatch.setattr(mcp, "run", lambda: calls.append(True))
    main_module.main()
    assert calls == [True]
